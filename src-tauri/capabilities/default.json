{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "The main window may change its appearance and read or save files selected through a native dialog.",
  "windows": ["main"],
  "permissions": ["core:default", "core:window:allow-set-theme", "dialog:allow-open", "dialog:allow-save", "fs:allow-read-file", "fs:allow-write-file"]
}
